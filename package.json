{
  "name": "sanarys-360",
  "private": true,
  "version": "0.1.0",
  "description": "SANARYS 360 - plateforme de sante operationnelle mutualisee pour zones industrielles",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate -w @sanarys/db",
    "setup": "node scripts/setup-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev:api": "npm run dev -w @sanarys/api",
    "dev:web": "npm run dev -w @sanarys/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @sanarys/api",
    "test:e2e": "npm run test -w @sanarys/e2e",
    "db:start": "bash scripts/db-start.sh",
    "db:create": "bash scripts/db-create.sh",
    "db:generate": "npm run prisma:generate -w @sanarys/db",
    "db:migrate": "npm run prisma:migrate -w @sanarys/db",
    "db:seed": "npm run seed -w @sanarys/db",
    "db:unlock": "node scripts/db-unlock.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
