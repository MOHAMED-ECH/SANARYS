# --- Base de donnees ---
DATABASE_URL="postgresql://sanarys:sanarys@localhost:5432/sanarys_dev"

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
SESSION_SECRET="change-me-in-production-min-32-chars-long"
CORS_ORIGIN="http://localhost:3000"
STORAGE_DIR="./var/storage"

# --- Web (Next.js) ---
# Cible des appels cote serveur et du proxy /api/v1 declare dans next.config.mjs.
API_INTERNAL_URL="http://127.0.0.1:4000/api/v1"

# Laisser vide en local : le navigateur appelle alors /api/v1 sur la meme
# origine (localhost:3000) et Next relaie vers l'API. Aucune requete
# cross-origin, donc aucun probleme de CORS.
# Ne renseigner cette variable qu'en environnement deploye, ou l'API a un
# domaine propre — et ajouter alors ce domaine a CORS_ORIGIN.
# NEXT_PUBLIC_API_BASE_URL="https://api.exemple.ma/api/v1"

# --- Integrations (mock adapters in this build, see README ledger) ---
NOTIFICATIONS_ADAPTER="console"
CRM_ADAPTER="noop"
